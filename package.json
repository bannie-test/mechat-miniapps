{
  "name": "iemanchat-miniapps",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:garden": "pnpm --filter garden dev",
    "dev:lunar": "pnpm --filter lunar dev",
